# r7 — transformers 5.14 for Qwen3.5 (qwen3_5) + Gemma 4 (gemma4)
# docker build -f docker/Dockerfile.unsloth -t llm-finetune/unsloth:cuda12.1.0-r7 .
FROM pytorch/pytorch:2.5.1-cuda12.1-cudnn9-devel

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    TOKENIZERS_PARALLELISM=false \
    TRANSFORMERS_NO_ADVISORY_WARNINGS=1

USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
        git git-lfs curl wget build-essential cmake ninja-build \
        libgomp1 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Gemma 4 + Qwen3.5 need transformers>=5.14 (gemma4 / qwen3_5).
# Pin known-good: transformers 5.14 + peft 0.15 + trl 0.17.
RUN pip install --upgrade pip setuptools wheel \
 && pip install --no-cache-dir \
      "transformers==5.14.1" \
      "tokenizers>=0.21.0" \
      "datasets>=3.0.0" \
      "accelerate>=1.2.0" \
      "peft==0.15.2" \
      "trl==0.17.0" \
      "bitsandbytes>=0.45.0" \
      "sentencepiece" \
      "protobuf" \
      "scipy" \
      "einops" \
      "packaging" \
      "huggingface_hub" \
      "safetensors" \
      "gguf" \
      "numpy<2.2" \
      "tqdm" \
      "psutil" \
      "tyro" \
      "rich" \
      "markdown-it-py" \
      "pygments" \
      "jinja2" \
      "aiohttp" \
 && pip uninstall -y torchao 2>/dev/null || true

# Keep torch stack from base image (2.5.1+cu121) — do not reinstall newer torch
RUN python -c "import torch; assert torch.__version__.startswith('2.5'), torch.__version__; print(torch.__version__)"

# llama.cpp quantize
RUN git clone --depth 1 https://github.com/ggerganov/llama.cpp /opt/llama.cpp \
 && cmake -S /opt/llama.cpp -B /opt/llama.cpp/build \
      -DGGML_CUDA=OFF -DGGML_NATIVE=OFF -DCMAKE_BUILD_TYPE=Release \
 && cmake --build /opt/llama.cpp/build --config Release -j"$(nproc)" \
 && (cp /opt/llama.cpp/build/bin/llama-quantize /usr/local/bin/llama-quantize 2>/dev/null \
     || cp /opt/llama.cpp/build/bin/quantize /usr/local/bin/llama-quantize 2>/dev/null \
     || true)

ENV PATH="/opt/llama.cpp/build/bin:${PATH}"

# Import peft before TrainingArguments to avoid circular HybridCache import
RUN python -c "\
import torch; \
print('torch', torch.__version__); \
import transformers; \
print('transformers', transformers.__version__); \
from transformers.models.auto.configuration_auto import CONFIG_MAPPING; \
assert 'qwen3_5' in CONFIG_MAPPING, sorted(k for k in CONFIG_MAPPING if 'qwen' in k); \
assert 'gemma4' in CONFIG_MAPPING, sorted(k for k in CONFIG_MAPPING if 'gemma' in k); \
from peft import LoraConfig; \
from transformers import TrainingArguments, AutoConfig; \
from trl import SFTTrainer; \
print('transformers ok qwen3_5+gemma4'); \
print('SMOKE_OK')"

WORKDIR /workspace
CMD ["bash"]
